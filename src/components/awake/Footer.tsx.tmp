            <ul>
              {nav.map((item) => (
                <li key={item.href}>
                  <Link href={item.href} className="footer-link">
                    {item.label}
                  </Link>
                </li>
              ))}
            </ul>
          </nav>

        <div className="footer-info">
          <div className="footer-infoBlock">
            <span className="footer-infoLabel">Contact us</span>
            <a href={`mailto:${contact.email}`} className="footer-infoValue">
